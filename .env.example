# Razorpay (Key Secret must only ever live here / in Vercel env vars, never in frontend code)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_key_secret_here

# Transactional messaging
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
RESEND_API_KEY=your_resend_api_key

# Comma-separated admin emails allowed to call send-status-* endpoints (Firebase Auth email of the admin account).
# While unset, those two endpoints are not admin-gated. Set this once the admin panel signs in with Firebase.
ADMIN_EMAILS=

# Optional
# FIREBASE_API_KEY=            (defaults to the public web API key of the maathruthva project)
# EXTRA_ALLOWED_ORIGINS=http://localhost:5500   (comma-separated, for local development only)
